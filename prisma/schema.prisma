generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(ATHLETE)
  password      String?
  emailVerified DateTime?
  // Feature flags (migrados de config.features)
  featurePlan      Boolean @default(true)
  featureCheckin   Boolean @default(true)
  featureNutrition Boolean @default(true)
  featureProgress  Boolean @default(true)
  featureLog       Boolean @default(true)
  featureCoach     Boolean @default(false)
  featureGym       Boolean @default(true)

  // Onboarding (migrado de config.onboarding)
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  // Google OAuth role selection (migrado de config === null check)
  needsRoleSelection Boolean @default(false)

  // Localización del dispositivo (detectada en login, actualizable vía PATCH /api/me)
  timezone   String?  // IANA tz, e.g. 'America/Mexico_City'. null = America/Bogota
  locale     String?  // BCP 47, e.g. 'es-MX'. null = es-CO

  // Push notifications (Expo Push Token del dispositivo mobile)
  pushToken  String?

  // Coach identity — anti-fraude y billing (ver domains/coach-identidad.md)
  identification  String?  @unique  // cédula / pasaporte / NIT — formato libre, 5-30 chars
  phoneWa         String?  @unique  // WhatsApp E.164: +57XXXXXXXXXX — único por coach
  showPhoneWa     Boolean  @default(false) // opt-in: mostrar phoneWa en perfil público /p/[slug]

  // Estado de la cuenta — control de acceso administrativo
  status  UserStatus  @default(ACTIVE)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription  UserSubscription?

  accounts          Account[]
  sessions          Session[]
  profile           HealthProfile?
  trainingPlans     TrainingPlan[]
  sessionLogs          SessionLog[]
  checkIns             WeeklyCheckIn[]
  nutritionPlan        NutritionPlan?
  nutritionAdjustments PendingNutritionAdjustment[]
  coachOf           CoachAthlete[]    @relation("CoachRelation")
  coachedBy         CoachAthlete[]    @relation("AthleteRelation")

  // Gym feature
  exercises            Exercise[]        @relation("CoachExercises")
  workoutTemplates     WorkoutTemplate[] @relation("CoachTemplates")
  athleteTemplates     WorkoutTemplate[] @relation("AthleteTemplates")
  coachAssignments     AssignedWorkout[] @relation("CoachAssignments")
  athleteAssignments   AssignedWorkout[] @relation("AthleteAssignments")
  gymSessions          GymSession[]

  // Marketplace
  coachProfile       CoachProfile?

  // Métricas diarias
  dailyLogs          DailyLog[]

  // Nutrición personalizada
  foodProfile        FoodProfile?
  mealPlan           MealPlan?
  foodLogs           FoodLog[]
  mealTemplates      MealTemplate[]

  // Invite codes
  inviteCodes        InviteCode[]  @relation("CoachInvites")
  usedInviteCodes    InviteCode[]  @relation("UsedInvites")

  // Benchmarks de rendimiento
  benchmarks         PerformanceBenchmark[]

  // Mensajería
  sentMessages       Message[] @relation("SentMessages")
  receivedMessages   Message[] @relation("ReceivedMessages")

  // Finanzas
  coachPayments      Payment[] @relation("CoachPayments")
  athletePayments    Payment[] @relation("AthletePayments")

  // Auditoría de pagos (acciones como actor)
  paymentAuditLogs   PaymentAuditLog[]

  // Auditoría de acciones admin
  adminActions       AdminAuditLog[] @relation("AdminActions")
  adminAuditTargets  AdminAuditLog[] @relation("AdminAuditTargets")

  // Rutina semanal self-directed (sin plan)
  weeklyRoutine      WeeklyRoutine?

  // Constructor Visual de Nutrición (coach y atleta B2C)
  nutritionTemplates        NutritionTemplate[]    @relation("CoachNutritionTemplates")
  athleteNutritionTemplates NutritionTemplate[]    @relation("AthleteNutritionTemplates")
  assignedNutritionPlan     AssignedNutritionPlan? @relation("AthleteNutritionPlan")
  coachNutritionPlans       AssignedNutritionPlan[] @relation("CoachNutritionPlans")

  // Notificaciones in-app
  notifications  Notification[]

  // Propuestas de alimentos a la librería global
  proposedFoods      FoodProposal[] @relation("ProposedFoods")
  reviewedProposals  FoodProposal[] @relation("ReviewedProposals")

  // Gamificación y wearables (DB-09 a DB-11)
  activityStreak     ActivityStreak?
  achievements       UserAchievement[]
  wearableConnections WearableConnection[]

  // Nutrición avanzada (DB-12, DB-17, DB-18, DB-19)
  plannedMeals       PlannedMeal[]
  waterLogs          WaterLog[]
  recipes            Recipe[]
  mealPlanVersionsAssigned MealPlanVersion[] @relation("MealPlanVersionAssigner")

  // Progreso visual (DB-20)
  progressPhotos     ProgressPhoto[]

  // Sugerencias de ajuste del check-in (CI-DB-01)
  checkInSuggestions CheckInSuggestion[]

  // Propuestas nutricionales del coach al atleta
  coachNutritionProposalsSent     CoachNutritionProposal[] @relation("CoachNutritionProposalsSent")
  coachNutritionProposalsReceived CoachNutritionProposal[] @relation("CoachNutritionProposalsReceived")

  // Swaps de alimentos sobre plan asignado por coach (NUT-SWAP-01)
  nutritionOverrides AthleteNutritionOverride[]
}

enum UserRole {
  ATHLETE
  COACH
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── COACH <> ATHLETE ───────────────────────────────────────────────────────

model CoachAthlete {
  id           String        @id @default(cuid())
  coachId      String
  athleteId    String
  status       AthleteStatus @default(ACTIVE)
  coachGoal    String?       // meta visible para el atleta (ej. "Bajar 5kg en 16 semanas")
  privateNotes String?       // notas privadas del coach — el atleta nunca las ve
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  coach   User @relation("CoachRelation",   fields: [coachId],   references: [id], onDelete: Cascade)
  athlete User @relation("AthleteRelation", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([athleteId])
  @@index([coachId, status])
}

enum AthleteStatus {
  ACTIVE
  PAUSED
}

// ─── INVITE CODES ───────────────────────────────────────────────────────────

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  coachId   String
  usedBy    String?   // athleteId que lo redimió — FK con SetNull
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  coach      User  @relation("CoachInvites", fields: [coachId], references: [id], onDelete: Cascade)
  usedByUser User? @relation("UsedInvites",  fields: [usedBy],  references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([expiresAt])
}

// ─── PERFIL DE SALUD ────────────────────────────────────────────────────────

model HealthProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  dateOfBirth    DateTime? @db.Date
  age            Int
  heightCm       Float
  weightKg       Float
  weightGoalKg   Float?
  hrResting      Int?
  hrMax          Int?
  ftp            Int?      // Cycling/Triathlon — Functional Threshold Power (watts)
  altitudeMeters Int?
  injuries       String[]
  conditions     String[]
  medications    String[]
  sleepHoursAvg  Float?
  sleepScoreAvg  Float?
  vo2maxEstimate Float?  // estimado desde wearable (ml/kg/min) — INT-05
  gender         String?   // male | female — afecta cálculo TDEE Mifflin-St Jeor (~166 kcal diferencia)
  // Sport-specific fields
  sport          String?   // RUNNING | CYCLING | SWIMMING | TRIATHLON | FOOTBALL | STRENGTH
  sportGoal      String?   // RACE | BODY_RECOMPOSITION | GENERAL_FITNESS (migrado de config.sport.goal)
  experienceLevel String?  // BEGINNER | INTERMEDIATE | ADVANCED
  sessionMinutes  Int?     // tiempo por sesión: 30, 45, 60, 90
  sportDetails   Json      @default("{}")  // campos específicos por deporte
  // Fuente de cada dato — preparado para integraciones con dispositivos
  dataSources    Json      @default("{}")  // { hrMax: {source:'garmin', updatedAt:''}, ftp: {...} }
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── TIPOS DE OBJETIVO ──────────────────────────────────────────────────────
// GoalType se usa como campo directo en TrainingPlan.goalType (no como FK a una tabla Goal)

enum GoalType {
  RACE_5K
  RACE_10K
  RACE_HALF_MARATHON
  RACE_MARATHON
  RACE_TRIATHLON
  RACE_CYCLING
  RACE_SWIMMING
  FOOTBALL_GPP
  STRENGTH_TRAINING
  BODY_RECOMPOSITION
  WEIGHT_LOSS
  GENERAL_FITNESS
}

// ─── PLAN DE ENTRENAMIENTO ──────────────────────────────────────────────────

model TrainingPlan {
  id                   String     @id @default(cuid())
  userId               String
  name                 String
  goalType             GoalType?  // enum constraint — antes era String?
  totalWeeks           Int
  startDate            DateTime
  endDate              DateTime
  status               PlanStatus @default(ACTIVE)
  hrZones              Json
  generatedBy          PlanSource @default(COACH)
  // BUILDER-02: template nutricional vinculado al plan (opcional)
  nutritionTemplateId  String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks              PlanWeek[]
  nutritionTemplate  NutritionTemplate? @relation(fields: [nutritionTemplateId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

enum PlanSource {
  COACH
}

model PlanWeek {
  id               String   @id @default(cuid())
  planId           String
  weekNumber       Int
  phase            Phase
  volumeKm         Float?
  focusDescription String?
  isRecoveryWeek   Boolean  @default(false)
  startDate        DateTime
  endDate          DateTime

  plan     TrainingPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions PlannedSession[]

  @@unique([planId, weekNumber])
}

enum Phase {
  BASE
  DESARROLLO
  ESPECIFICO
  AFINAMIENTO
}

model PlannedSession {
  id           String           @id @default(cuid())
  weekId       String
  dayOfWeek    Int
  type         SessionType
  intensity    SessionIntensity @default(MODERATE)
  durationMin  Int
  zoneTarget   String?
  structure    String?
  detailText   String?
  sportLabel   String?          // etiqueta libre por deporte: "Sweet Spot 2×20min", "CSS 400m × 8"
  coachNote    String?
  date         DateTime
  workoutDayId String?          // link to WorkoutDay when type=FUERZA

  week       PlanWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  log        SessionLog?
  workoutDay WorkoutDay? @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)
  gymSession GymSession?

  @@index([weekId])
  @@index([date])
}

enum SessionIntensity {
  HIGH      // INTERVALOS, TIRADA_LARGA, SIMULACRO, TEST
  MODERATE  // TEMPO, FARTLEK, CICLA, NATACION, FUERZA
  LOW       // RODAJE_Z2, técnico/ligero
  REST      // DESCANSO
}

enum SessionType {
  RODAJE_Z2
  FARTLEK
  TEMPO
  INTERVALOS
  TIRADA_LARGA
  FUERZA
  CICLA
  NATACION
  DESCANSO
  TEST
  SIMULACRO
  OTRO
}

enum SessionDiscipline {
  RUNNING
  STRENGTH
  CYCLING
  SWIMMING
  OTHER
}

// ─── REGISTRO DE SESIÓN ─────────────────────────────────────────────────────

model SessionLog {
  id               String            @id @default(cuid())
  userId           String
  plannedSessionId String?           @unique
  completedAt      DateTime          @default(now())
  sessionDate      DateTime?         @db.Date // fecha real de la sesión (puede ser ayer/anteayer)
  rpe              Int?
  hrAvg            Int?
  hrMax            Int?
  distanceKm       Float?
  durationMin      Int?
  energyState      String?  // EXHAUSTED | NORMAL | ENERGIZED
  discomfort       String?  // NONE | MILD | MODERATE
  notes            String?
  garminActivityId String?
  freeSessionType  SessionType?      // solo para logs libres (plannedSessionId = null)
  actualIntensity  SessionIntensity? // intensidad real registrada por el atleta
  discipline       SessionDiscipline? // discriminador de deporte — RUNNING|STRENGTH|CYCLING|SWIMMING|OTHER
  // Wearables — INT-05
  caloriesBurned   Int?    // kcal totales quemadas (fuente: wearable)
  avgPaceSecPerKm  Int?    // ritmo promedio en segundos/km (running)
  dataSource       String? // MANUAL | STRAVA | GARMIN | HEALTHKIT
  externalId       String? // ID externo (Strava activity ID, Garmin activity ID, etc.)

  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedSession           PlannedSession?            @relation(fields: [plannedSessionId], references: [id], onDelete: SetNull)
  nutritionAdjustment      PendingNutritionAdjustment?

  @@index([userId])
  @@index([completedAt])
  @@index([userId, completedAt(sort: Desc)])
}

// ─── RUTINA SEMANAL SELF-DIRECTED ───────────────────────────────────────────

model WeeklyRoutine {
  id          String   @id @default(cuid())
  userId      String   @unique
  daysPerWeek Int      @default(4)
  // [{dow:1, activity:"GYM", split:"PUSH"}, {dow:2, activity:"RUN", runType:"RODAJE_Z2"}, ...]
  // activity: "GYM" | "RUN" | "REST"
  // split (gym): "PUSH" | "PULL" | "LEGS" | "FULL_BODY" | null
  // runType (run): "RODAJE_Z2" | "TEMPO" | "INTERVALOS" | "TIRADA_LARGA" | null
  days        Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── MÉTRICAS DIARIAS ───────────────────────────────────────────────────────

model DailyLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  weightKg    Float?
  hrResting   Int?
  sleepHours  Float?
  energyLevel Int?     // 1-5
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ─── CHECK-IN SEMANAL ───────────────────────────────────────────────────────

model WeeklyCheckIn {
  id                   String   @id @default(cuid())
  userId               String
  planId               String?  // null = sin plan activo (ISO week). Ver partial indexes en migration.
  weekNumber           Int
  recordedAt           DateTime @default(now())
  weightKg             Float?
  hrResting            Int?
  sleepHours           Float?
  sleepScore           Float?
  hardestSessionRpe    Int?
  dietAdherencePct     Int?
  painLevel            Int?     // 1-10: intensidad de dolor/molestia. painFlag derivado: painLevel >= 5
  painFlag             Boolean  @default(false)
  painDescription      String?  // descripción libre de la molestia/lesión reportada
  energyLevel          Int?     // 1-10 (normalizado desde ambas plataformas)
  stressLevel          Int?     // 1-10
  motivationLevel      Int?     // 1-10
  nutritionAdherencePct Int?    // 0-100: % adherencia al plan de comida (subjetivo)
  // Medidas corporales (opcional — registradas en check-in)
  waistCm              Float?  // cintura (cm)
  armsCm               Float?  // brazos (cm, promedio)
  hipsCm               Float?  // caderas (cm)
  thighsCm             Float?  // muslos (cm, promedio)
  hrvMs                Float?  // Heart Rate Variability en milisegundos — INT-05
  notes                String?
  adjustmentsTriggered String[]

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions CheckInSuggestion[]

  // Unicidad manejada por dos partial indexes en SQL (ver migration fix_checkin_plan_scope):
  //   WHERE planId IS NOT NULL → unique (userId, planId, weekNumber)
  //   WHERE planId IS NULL     → unique (userId, weekNumber)
  // Prisma no soporta partial indexes en schema — se aplicaron manualmente.
  @@index([userId])
  @@index([planId])
  @@index([userId, weekNumber])
}

// ─── GYM COACH FEATURE ──────────────────────────────────────────────────────

model Exercise {
  id                String    @id @default(cuid())
  coachId           String?   // null = librería global (WorkoutX), string = ejercicio personalizado del coach

  name              String
  bodyPart          String
  target            String
  equipment         String
  difficulty        String?
  mechanic          String?   // "compound" | "isolation"
  force             String?   // "push" | "pull" | "static"
  caloriesPerMinute Float?
  met               Float?
  popularityRank    Int?
  isUnilateral      Boolean   @default(false)
  recommendedSets   String?
  recommendedReps   String?
  description       String?
  secondaryMuscles  String[]
  instructions      String[]
  nameEs            String?   // nombre en español (WorkoutX lang=es)
  instructionsEs    String[]  // instrucciones en español

  gifUrl            String?   // URL CDN WorkoutX — null para ejercicios custom del coach
  gifStoredUrl      String?   // URL S3 propia — null hasta Fase 4
  videoUrl          String?   // YouTube URL o Vercel Blob URL

  source            String    @default("workoutx")  // "workoutx" | "custom" | "manual"
  syncedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  coach            User?             @relation("CoachExercises", fields: [coachId], references: [id])
  workoutExercises WorkoutExercise[]

  @@index([bodyPart])
  @@index([target])
  @@index([equipment])
}

model WorkoutTemplate {
  id          String  @id @default(cuid())
  coachId     String?   // null = plantilla pública del sistema o rutina del atleta
  athleteId   String?   // null = coach/sistema. string = rutina propia del atleta sin coach
  name        String
  description String?
  goal        String? // "HYPERTROPHY", "STRENGTH", "TONING", "FUNCTIONAL"
  level       String? // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  daysPerWeek Int     @default(3)
  isPublic    Boolean @default(false) // true = visible para todos los atletas
  isActive    Boolean @default(true)
  category    String? // "PPL", "FULL_BODY", "UPPER_LOWER", "STRENGTH", "BEGINNER"

  coach       User?            @relation("CoachTemplates", fields: [coachId], references: [id])
  athlete     User?            @relation("AthleteTemplates", fields: [athleteId], references: [id])
  days        WorkoutDay[]
  assignments AssignedWorkout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic, isActive])
}

model WorkoutDay {
  id           String   @id @default(cuid())
  templateId   String
  dayOfWeek    Int      // 1=Lunes … 7=Domingo
  label        String   // "Lunes — Cuádriceps y Gemelos"
  muscleGroups String[]
  isRestDay    Boolean  @default(false)
  warmupNotes  String?
  cardioNotes  String?
  order        Int      @default(0)

  template         WorkoutTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercises        WorkoutExercise[]
  plannedSessions  PlannedSession[]
}

model WorkoutExercise {
  id           String      @id @default(cuid())
  dayId        String
  exerciseId   String
  order        Int
  sets         Int         // 4
  repsScheme   String      // "12-15-18-20" | "12" | "hasta el fallo"
  restSeconds  Int?        // 90
  notes        String?
  setType      SetType     @default(NORMAL)
  supersetWith String?     // id de otro WorkoutExercise

  // Progresión de cargas: peso sugerido para la próxima sesión (actualizado al completar)
  suggestedNextWeightKg Float?

  day      WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id])
  setLogs  SetLog[]
}

enum SetType {
  NORMAL
  SUPERSET
  BISERIE
  DROPSET
  CIRCUIT
}

// Tipo de set a nivel de log — independiente del tipo estructural en WorkoutExercise
enum SetLogType {
  WORK     // set de trabajo real — cuenta para volumen y PR detection
  WARMUP   // calentamiento — excluido de volumen y PRs
  DROPSET  // drop set — excluido de PR detection, incluido en volumen
}

model AssignedWorkout {
  id            String    @id @default(cuid())
  templateId    String
  athleteId     String
  coachId       String?   // null = auto-asignado por el atleta (sin coach)
  startDate     DateTime
  endDate       DateTime?
  weeksDuration Int?
  isActive      Boolean   @default(true)
  notes         String?

  template    WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  athlete     User            @relation("AthleteAssignments", fields: [athleteId], references: [id])
  coach       User?           @relation("CoachAssignments", fields: [coachId], references: [id])
  gymSessions GymSession[]

  createdAt DateTime @default(now())

  @@index([athleteId, isActive])
}

model GymSession {
  id                String   @id @default(cuid())
  athleteId         String
  assignedWorkoutId String?  // null when session comes from a TrainingPlan (plannedSessionId set)
  plannedSessionId  String?  @unique  // link to PlannedSession — exclusive with assignedWorkoutId
  dayOfWeek         Int
  date              DateTime
  durationMin       Int?
  rpe               Int?     // 1-10
  energyState       String?  // EXHAUSTED | NORMAL | ENERGIZED
  discomfort        String?  // NONE | MILD | MODERATE
  caloriesBurned    Int?     // kcal estimadas (durationMin × avgCaloriesPerMinute de los ejercicios)
  notes             String?
  completed         Boolean  @default(false)

  exerciseOverrides Json?   // [{ originalWorkoutExerciseId, replacedWithExerciseId, replacedExerciseName, reason? }]

  athlete         User             @relation(fields: [athleteId], references: [id])
  assignedWorkout AssignedWorkout? @relation(fields: [assignedWorkoutId], references: [id])
  plannedSession  PlannedSession?  @relation(fields: [plannedSessionId], references: [id])
  setLogs         SetLog[]

  createdAt DateTime @default(now())

  @@unique([athleteId, date, assignedWorkoutId])  // legacy template-based sessions
  @@unique([athleteId, date, plannedSessionId])   // plan-based sessions
  @@index([athleteId, completed])
  @@index([athleteId, date])
  @@index([athleteId, completed, date])
}

model SetLog {
  id                String  @id @default(cuid())
  sessionId         String
  workoutExerciseId String?  // nullable — SetNull when coach edits/deletes exercise from routine
  exerciseName      String?  // desnormalized — preserves name even if WorkoutExercise is deleted
  setNumber         Int
  weightKg          Float?
  repsCompleted     Int?
  completed         Boolean @default(false)
  isPR              Boolean    @default(false)
  setLogType        SetLogType @default(WORK) // tipo de set — excluye WARMUP/DROPSET de volumen y PRs
  rpe               Int?       // Rating of Perceived Exertion 1-10 para este set
  notes             String?

  session         GymSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([workoutExerciseId])
  @@index([exerciseName, completed])
}

// ─── MARKETPLACE DE COACHES ─────────────────────────────────────────────────

model CoachProfile {
  id               String         @id @default(cuid())
  coachId          String         @unique
  slug             String         @unique   // "carlos-entrenador"
  primarySpecialty CoachSpecialty @default(ALL) // @deprecated — usar specialties[]. Se mantiene por backward compat hasta migración completa.
  bio              String?
  avatarUrl        String?
  headline         String?            // "Especialista en media maratón y recomposición"
  specialties      String[]           // Fuente canónica de disciplinas del coach: ["RUNNING", "GYM", "NUTRITION", "CYCLING", "SWIMMING", "YOGA", "FUNCTIONAL"]
  city           String?
  country        String   @default("CO")
  whatsapp       String?
  instagram      String?
  yearsExp       Int?
  certifications String[]
  isPublic       Boolean  @default(false)

  coach    User           @relation(fields: [coachId], references: [id])
  programs CoachProgram[]
  posts    CoachPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic])
}

model CoachProgram {
  id            String   @id @default(cuid())
  profileId     String
  name          String   // "Plan Media Maratón — 18 semanas"
  description   String?
  sport         String   // "RUNNING", "GYM", "CYCLING", "TRIATHLON", "FUNCTIONAL"
  level         String   // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  durationWeeks Int?
  priceMonth    Float?   // USD/mes
  currency      String   @default("USD")
  includes      String[] // ["Plan personalizado", "Check-in semanal", "Chat directo"]
  isActive      Boolean  @default(true)

  profile CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model CoachPost {
  id        String   @id @default(cuid())
  profileId String
  type      PostType
  title     String
  body      String
  imageUrl  String?
  tags      String[]
  isPublic  Boolean  @default(true)

  profile CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum PostType {
  TIP
  ROUTINE_SHOWCASE
  ACHIEVEMENT
  ANNOUNCEMENT
}

// ─── PLAN NUTRICIONAL ───────────────────────────────────────────────────────

enum NutritionSource {
  SYSTEM  // generado por onboarding o check-in automático
  COACH   // asignado por el coach vía NutritionTemplate
  ATHLETE // creado por el atleta B2C (self-coach)
}

/// Singleton — siempre un solo registro con id = "singleton"
model SystemConfig {
  id           String    @id @default("singleton")
  updatedAt    DateTime  @updatedAt
}

model NutritionPlan {
  id             String          @id @default(cuid())
  userId         String          @unique
  source         NutritionSource @default(SYSTEM) // origen del plan: SYSTEM | COACH | ATHLETE
  tdee           Int
  targetKcalHard Int
  targetKcalEasy Int
  targetKcalRest Int
  proteinG       Int
  carbsHardG     Int
  carbsEasyG     Int
  fatG           Int
  kcalAdjustment Int             @default(0)    // déficit (-) o superávit (+) en kcal. Rango: -750 a +500
  waterMlTarget  Int?            @default(2000) // meta de hidratación diaria (ml) — DB-18
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── NUTRICIÓN PERSONALIZADA ─────────────────────────────────────────────────

model FoodProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  availableFoods   String[]
  availableFoodIds String[]  // IDs linkeados a Food.id — para cálculo de macros
  restrictions     String[]
  mealsPerDay    Int      @default(3)
  weighsFood     Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id          String   @id @default(cuid())
  userId      String   @unique
  data        Json     // { hard: DayMeals, easy: DayMeals, rest: DayMeals }
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions MealPlanVersion[]
}

// ─── LIBRERÍA DE ALIMENTOS ──────────────────────────────────────────────────

model Food {
  id             String   @id @default(cuid())
  name           String
  category       String   // PROTEIN | CARB | FAT | VEGETABLE | FRUIT | DAIRY | LEGUME | NUT_SEED | OTHER
  // Macronutrientes por 100g
  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float
  // Micronutrientes por 100g (clave para atletas)
  fiberPer100g   Float?   // fibra (g)
  calciumMg      Float?   // calcio (mg)
  ironMg         Float?   // hierro (mg)
  potassiumMg    Float?   // potasio (mg)
  vitaminCMg     Float?   // vitamina C (mg)
  magnesiumMg    Float?   // magnesio (mg)
  sodiumMg       Float?   // sodio (mg)
  // Porción típica
  servingG       Float    @default(100) // gramos por porción típica
  servingLabel   String?               // "1 pechuga mediana", "2 cucharadas", etc.
  // Meta
  isVerified     Boolean  @default(true)  // false = enviado por comunidad, pendiente revisión
  createdBy      String?                  // null = sistema Medaliq
  isActive       Boolean  @default(true)
  // Trazabilidad y búsqueda por código — NUT-01
  source         String   @default("system") // system | usda | icbf | openfoodfacts | community
  barcode        String?  @unique             // EAN-13 / UPC para lookup Open Food Facts
  country        String?                      // ISO 3166-1 alpha-2 (CO, MX, AR, PE...)
  createdAt      DateTime @default(now())

  foodLogs              FoodLog[]
  mealTemplateItems     MealTemplateItem[]
  nutritionTemplateItems NutritionTemplateFoodItem[]
  proposals             FoodProposal[]
  plannedMeals          PlannedMeal[]
  recipeIngredients     RecipeIngredient[]
  nutritionOverrides    AthleteNutritionOverride[]

  @@index([category])
  @@index([isActive])
  @@index([barcode])
  @@index([country])
}

// Registro diario de ingesta — listo para fase de tracking
model FoodLog {
  id            String   @id @default(cuid())
  userId        String
  foodId        String
  date          DateTime @db.Date
  mealType      MealType
  grams         Float
  // Snapshot de macros al crear el log — preserva histórico si Food.kcalPer100g se actualiza
  kcalLogged    Float?
  proteinLogged Float?
  carbsLogged   Float?
  fatLogged     Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, foodId, date, mealType])
  @@index([userId, date])
}

// Plantillas de comidas guardadas — el atleta registra combos frecuentes en 1 tap
model MealTemplate {
  id        String             @id @default(cuid())
  userId    String
  name      String
  mealType  MealType?
  items     MealTemplateItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MealTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  foodId     String
  grams      Float

  template MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  food     Food         @relation(fields: [foodId], references: [id])
}

model PerformanceBenchmark {
  id        String   @id @default(cuid())
  userId    String
  coachId   String?
  sport     String   // RUNNING | CYCLING | SWIMMING | STRENGTH | TRIATHLON
  metric    String   // 5K_TIME | 10K_TIME | HALF_MARATHON_TIME | MARATHON_TIME | FTP_WATTS | CSS_PACE | 1RM_SQUAT | 1RM_DEADLIFT | 1RM_BENCH | VO2MAX
  value     Float
  unit      String   // seconds | watts | kg | ml_kg_min
  testedAt  DateTime
  notes     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, sport])
  @@index([userId, metric, testedAt])
}

// ─── FINANZAS ────────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  coachId     String
  athleteId   String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String        @default("COP")
  description String?
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  coach   User  @relation("CoachPayments",   fields: [coachId],   references: [id], onDelete: Cascade)
  athlete User? @relation("AthletePayments", fields: [athleteId], references: [id], onDelete: SetNull)

  auditLogs PaymentAuditLog[]

  @@index([coachId, status])
  @@index([coachId, athleteId])
  @@index([dueDate, status])
}

enum PaymentStatus {
  PENDING
  PAID
}

model PaymentAuditLog {
  id        String   @id @default(cuid())
  paymentId String
  action    String   // CREATED | MARKED_PAID | REMINDED
  actorId   String
  note      String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// ─── ESPECIALIDAD COACH ──────────────────────────────────────────────────────

enum CoachSpecialty {
  RUNNING     // Constructor de sesiones con zonas FC/pace/distancia
  GYM         // Constructor de rutinas de fuerza
  NUTRITION   // Solo plantillas nutricionales
  ALL         // Acceso completo — todas las herramientas
}

// ─── SUSCRIPCIONES ───────────────────────────────────────────────────────────

enum SubscriptionTier {
  TRIAL
  FREE
  PRO
}

enum CoachSubscriptionTier {
  STARTER  // hasta 5 asesorados — gratis
  GROWTH   // 6-25 asesorados — $39/mes
  PRO      // 26-75 asesorados — $79/mes
  SCALE    // +75 asesorados — $129/mes
}

model UserSubscription {
  id                 String           @id @default(cuid())
  userId             String           @unique
  tier               SubscriptionTier @default(TRIAL)
  coachTier          CoachSubscriptionTier @default(STARTER)  // solo relevante para coaches
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  externalCustomerId String?          // Stripe/Wompi customer ID
  externalPriceId    String?          // Stripe/Wompi price ID
  cancelAtPeriodEnd  Boolean          @default(false)
  gateway            String?          // 'wompi' | 'mercadopago' | null
  lastWebhookEventId String?          // idempotencia: Wompi puede reenviar el mismo evento
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── MENSAJERÍA ──────────────────────────────────────────────────────────────

model Message {
  id        String    @id @default(cuid())
  fromId    String?   // nullable: SetNull cuando el emisor elimina su cuenta
  toId      String?   // nullable: SetNull cuando el receptor elimina su cuenta
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  from User? @relation("SentMessages",     fields: [fromId], references: [id], onDelete: SetNull)
  to   User? @relation("ReceivedMessages", fields: [toId],   references: [id], onDelete: SetNull)

  @@index([fromId, toId, createdAt])
  @@index([toId, readAt])
}

// ─── AJUSTE NUTRICIONAL POR INTENSIDAD REAL ──────────────────────────────────

model PendingNutritionAdjustment {
  id               String           @id @default(cuid())
  userId           String
  date             DateTime         @db.Date       // día al que aplica el ajuste
  sessionLogId     String?          @unique         // SessionLog que disparó el ajuste
  plannedIntensity SessionIntensity
  actualIntensity  SessionIntensity
  deltaKcal        Int                              // adjustedKcal − plannedKcal (puede ser negativo)
  deltaCarbsG      Int                              // adjustedCarbsG − plannedCarbsG
  plannedKcal      Int
  plannedCarbsG    Int
  adjustedKcal     Int
  adjustedCarbsG   Int
  status           AdjustmentStatus @default(PENDING)
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionLog SessionLog? @relation(fields: [sessionLogId], references: [id], onDelete: SetNull)

  @@unique([userId, date])    // un ajuste por atleta por día
  @@index([userId, status])
  @@index([userId, date])
}

enum AdjustmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

// ─── CONSTRUCTOR VISUAL DE NUTRICIÓN ─────────────────────────────────────────

enum NutritionDayType {
  HARD
  EASY
  REST
}

// Plan nutricional reutilizable — del coach o del atleta B2C (coachId XOR athleteId)
model NutritionTemplate {
  id          String   @id @default(cuid())
  coachId     String?  // null si es template propio del atleta B2C
  athleteId   String?  // null si es template del coach; FK → User
  name        String
  description String?
  goal        String?  // "RENDIMIENTO", "PÉRDIDA DE PESO", "GANANCIA MUSCULAR", "MANTENIMIENTO"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coach       User?                   @relation("CoachNutritionTemplates",  fields: [coachId],   references: [id], onDelete: Cascade)
  athlete     User?                   @relation("AthleteNutritionTemplates", fields: [athleteId], references: [id], onDelete: Cascade)
  days        NutritionTemplateDay[]
  assignments AssignedNutritionPlan[]
  trainingPlans TrainingPlan[]

  @@index([coachId])
  @@index([athleteId])
}

// Un día por tipo (HARD/EASY/REST) dentro del template
model NutritionTemplateDay {
  id         String           @id @default(cuid())
  templateId String
  dayType    NutritionDayType

  template NutritionTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  meals    NutritionTemplateMeal[]

  @@unique([templateId, dayType])
}

// Una comida dentro de un día (BREAKFAST, LUNCH, etc.)
model NutritionTemplateMeal {
  id       String   @id @default(cuid())
  dayId    String
  mealType MealType
  order    Int      @default(0)

  day   NutritionTemplateDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  items NutritionTemplateFoodItem[]

  @@unique([dayId, mealType])
}

// Un alimento con gramaje dentro de una comida
model NutritionTemplateFoodItem {
  id       String @id @default(cuid())
  mealId   String
  foodId   String
  grams    Float
  // Snapshot de macros al crear — independiente de cambios futuros en Food
  kcal     Float
  proteinG Float
  carbsG   Float
  fatG     Float
  order    Int    @default(0)

  meal NutritionTemplateMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food                  @relation(fields: [foodId], references: [id])

  @@index([mealId])
}

// Asignación activa de un template a un atleta
model AssignedNutritionPlan {
  id         String   @id @default(cuid())
  templateId String
  athleteId  String   @unique  // un atleta tiene máximo una asignación activa
  coachId    String
  assignedAt DateTime @default(now())

  template NutritionTemplate @relation(fields: [templateId], references: [id])
  athlete  User              @relation("AthleteNutritionPlan", fields: [athleteId], references: [id], onDelete: Cascade)
  coach    User              @relation("CoachNutritionPlans",  fields: [coachId],   references: [id])

  @@index([coachId])
  @@index([templateId])
}

// ─── NOTIFICACIONES IN-APP ───────────────────────────────────────────────────
// PLT-07 — centro de notificaciones in-app (campana + feed de eventos)

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // SESION_HOY | CHECKIN_DISPONIBLE | PLAN_ACTUALIZADO | MENSAJE_COACH | AJUSTE_NUTRICIONAL | LOGRO | PROPUESTA_COACH
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?    // payload extra según el tipo (planId, sessionId, etc.)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── PROPUESTAS DE ALIMENTOS ─────────────────────────────────────────────────
// NUT-03 — atleta propone alimento a la librería global — admin aprueba/rechaza

enum FoodProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model FoodProposal {
  id             String             @id @default(cuid())
  submittedById  String
  name           String
  category       String             // PROTEIN | CARB | FAT | VEGETABLE | FRUIT | DAIRY | LEGUME | OTHER
  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float
  country        String?            // ISO 3166-1 alpha-2
  notes          String?            // notas del atleta al proponer
  status         FoodProposalStatus @default(PENDING)
  reviewedById   String?
  reviewNote     String?            // motivo de rechazo o nota de aprobación
  foodId         String?            // Food creado al aceptar la propuesta
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  submittedBy  User  @relation("ProposedFoods",     fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy   User? @relation("ReviewedProposals", fields: [reviewedById],  references: [id], onDelete: SetNull)
  food         Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedById])
}

// ─── AUDITORÍA ADMIN ─────────────────────────────────────────────────────────

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String   // CHANGE_ROLE | CHANGE_PLAN | UPDATE_AI_PROFILE
  targetUserId String?
  meta         Json?    // e.g. { from: 'ATHLETE', to: 'COACH' } | { plan: 'PRO' }
  createdAt    DateTime @default(now())

  admin      User  @relation("AdminActions",      fields: [adminId],      references: [id], onDelete: Cascade)
  targetUser User? @relation("AdminAuditTargets", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt(sort: Desc)])
}

// ─── GAMIFICACIÓN — DB-09, DB-10 ─────────────────────────────────────────────

model ActivityStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActivityAt DateTime?
  updatedAt      DateTime  @updatedAt
}

model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // "STREAK_10" | "SESSIONS_50" | "MONTHS_3" | "PLAN_COMPLETE"
  unlockedAt DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

// ─── WEARABLES — DB-11 ───────────────────────────────────────────────────────

model WearableConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String    // "strava" | "garmin" | "healthkit"
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  scopes            String[]
  /** ID del atleta/cuenta en el proveedor — para mapear webhooks (ej. Strava owner_id) */
  providerAccountId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider, providerAccountId])
}

// ─── NUTRICIÓN AVANZADA — DB-12, DB-17, DB-18, DB-19 ────────────────────────

model PlannedMeal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mealType  MealType
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id])
  grams     Float
  createdAt DateTime @default(now())

  overrides AthleteNutritionOverride[]

  @@index([userId, date])
}

// Swap de alimentos — atleta sustituye un alimento del plan del coach (NUT-SWAP-01)
// El atleta puede cambiar un alimento asignado por uno equivalente (±10% kcal).
// El swap persiste aquí sin tocar el PlannedMeal original del coach.
model AthleteNutritionOverride {
  id             String      @id @default(cuid())
  athleteId      String
  athlete        User        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  plannedMealId  String
  plannedMeal    PlannedMeal @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)
  overrideFoodId String
  overrideFood   Food        @relation(fields: [overrideFoodId], references: [id])
  overrideGrams  Float
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([athleteId, plannedMealId])
  @@index([athleteId])
}

// DEPRECATED (NUT-13): no read/write endpoints exist
model Recipe {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  ingredients RecipeIngredient[]
  createdAt   DateTime           @default(now())

  @@index([userId])
}

// DEPRECATED (NUT-13): no read/write endpoints exist
model RecipeIngredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId   String
  food     Food   @relation(fields: [foodId], references: [id])
  grams    Float

  @@index([recipeId])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mlLogged  Int
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

// DEPRECATED (NUT-13): populated but never read by any endpoint
model MealPlanVersion {
  id           String   @id @default(cuid())
  userId       String
  mealPlanId   String
  mealPlan     MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  version      Int
  planData     Json
  assignedAt   DateTime @default(now())
  assignedById String?
  assignedBy   User?    @relation("MealPlanVersionAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId, mealPlanId])
}

// ─── PROGRESO VISUAL — DB-20 ─────────────────────────────────────────────────

model ProgressPhoto {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String   // Vercel Blob URL
  takenAt     DateTime
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, takenAt])
}

// ─── CHECK-IN SUGERENCIAS (CI-DB-01) ────────────────────────────────────────

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SuggestionType {
  PLAN_ADJUSTMENT
  RECOVERY_WEEK
  NUTRITION_CHANGE
  GYM_DELOAD
}

model CheckInSuggestion {
  id          String           @id @default(cuid())
  userId      String
  checkInId   String
  type        SuggestionType
  status      SuggestionStatus @default(PENDING)
  title       String
  description String
  payload     Json             // datos específicos del ajuste sugerido
  expiresAt   DateTime         // checkIn.recordedAt + 7 días
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn WeeklyCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([checkInId])
}

model CoachNutritionProposal {
  id           String                  @id @default(cuid())
  coachId      String
  athleteId    String
  message      String
  deltaKcal    Int                     @default(0)
  deltaProtein Int                     @default(0)
  deltaCarbs   Int                     @default(0)
  deltaFat     Int                     @default(0)
  status       CoachProposalStatus     @default(PENDING)
  respondedAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  coach   User @relation("CoachNutritionProposalsSent",     fields: [coachId],   references: [id], onDelete: Cascade)
  athlete User @relation("CoachNutritionProposalsReceived", fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, status])
  @@index([coachId])
}

enum CoachProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ─── Admin — Feature configuration per user type ─────────────────────────────

enum AthleteUserType {
  B2C_FREE
  B2C_PRO
  B2B
}

model TierFeatureConfig {
  id               String          @id @default(cuid())
  userType         AthleteUserType @unique
  featurePlan      Boolean         @default(false)
  featureCheckin   Boolean         @default(false)
  featureNutrition Boolean         @default(true)
  featureProgress  Boolean         @default(false)
  featureLog       Boolean         @default(true)
  featureGym       Boolean         @default(true)
  updatedAt        DateTime        @updatedAt
  updatedBy        String?         // admin userId que hizo el último cambio
}
