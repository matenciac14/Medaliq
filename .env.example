# ── Base ──────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medaliq"

# ── Auth (REQUERIDO) ─────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (web) — console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Upstash Redis — console.upstash.com (Free: 10k req/dia)
# Sin estas vars el rate limiter usa memoria local (solo dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Email ────────────────────────────────────────────────────────────────────
# Resend — resend.com (Free: 100 emails/dia)
RESEND_API_KEY=""

# ── Cron Jobs ────────────────────────────────────────────────────────────────
# Secret para proteger endpoints /api/cron/* — generar con: openssl rand -hex 32
CRON_SECRET=""

# ── Billing (opcional — sin estas vars todos son PRO) ────────────────────────
# BILLING_ENABLED="true"
# PAYMENT_GATEWAY="wompi"
# WOMPI_PRIVATE_KEY=""
# WOMPI_PUBLIC_KEY=""
# WOMPI_INTEGRITY_SECRET=""
# WOMPI_SANDBOX="true"

# ── Push Notifications (opcional) ────────────────────────────────────────────
# Expo — expo.dev (para push notifications mobile)
# EXPO_ACCESS_TOKEN=""

# ── Email Verification Gate (opcional) ───────────────────────────────────────
# Si true, usuarios deben verificar email antes de login mobile
# EMAIL_GATE_ENABLED="false"

# ── Strava (opcional — sin estas vars la integracion no se activa) ──────────
# Crear app en strava.com/settings/api
# STRAVA_CLIENT_ID=""
# STRAVA_CLIENT_SECRET=""
# Generar con: openssl rand -hex 16
# STRAVA_WEBHOOK_VERIFY_TOKEN=""

# ── App URL (produccion) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL="https://medaliq.com"
